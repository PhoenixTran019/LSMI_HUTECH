@page
@model LmsMini.WebApp.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - DbLMS</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="split-login-page d-flex min-vh-100">

    <!-- Left hero (hidden on small screens) -->
    <aside class="login-image-section d-none d-md-flex col-md-6 col-lg-7">
        <div class="image-overlay d-flex align-items-center">
            <div class="login-hero text-white fade-up in">
                <h1>Học tập thông minh — Tương lai sáng</h1>
                <p class="lead">I-HUTECH LMS — nền tảng quản lý học tập được thiết kế để giảng dạy, theo dõi tiến độ và kết nối cộng đồng sinh viên & giảng viên.</p>

                <ul class="list-unstyled caption mb-0">
                    <li class="mb-2"><i class="bi bi-check-circle-fill me-2"></i> Giao diện trực quan, thao tác nhanh</li>
                    <li class="mb-2"><i class="bi bi-pie-chart-fill me-2"></i> Thống kê & báo cáo trực quan</li>
                    <li class="mb-2"><i class="bi bi-shield-lock-fill me-2"></i> Bảo mật, quyền hạn rõ ràng</li>
                </ul>
            </div>
        </div>
    </aside>

    <!-- Right form -->
    <main class="login-form-section d-flex align-items-center justify-content-center col-12 col-md-6 col-lg-5">
        <div class="card login-card w-100 fade-up in" role="region" aria-labelledby="loginTitle">
            <div class="text-center mb-3">
                <h3 id="loginTitle" class="text-primary-default mb-1" style="font-weight:800; font-size:1.6rem;">I-HUTECH</h3>
                <p class="caption text-text-light mb-0">Learning Management System</p>
            </div>

            <h4 class="h5 text-text-dark fw-semibold mb-3">Đăng nhập tài khoản của bạn</h4>

            <form method="post" novalidate>
                <!-- GIỮ ReturnUrl -->
                <input type="hidden" asp-for="ReturnUrl" />

                <!-- Validation summary (server-side) -->
                <div asp-validation-summary="ModelOnly" class="alert alert-danger visually-hidden" role="alert" id="validationSummary"></div>

                <div class="mb-3">
                    <label class="form-label visually-hidden" for="username">Tên đăng nhập</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-person-fill"></i></span>
                        <input asp-for="Input.UserName" id="username" class="form-control border-start-0"
                               placeholder="Tên đăng nhập" aria-label="Tên đăng nhập" autocomplete="username" />
                    </div>
                    <span asp-validation-for="Input.UserName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label visually-hidden" for="password">Mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-lock-fill"></i></span>
                        <input asp-for="Input.Password" id="password" class="form-control border-start-0"
                               type="password" placeholder="Mật khẩu" aria-label="Mật khẩu" autocomplete="current-password" />
                        <button type="button" class="btn btn-outline-secondary" id="togglePwd" aria-label="Hiện mật khẩu">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="alt-actions">
                    <div>
                        <a asp-page="/Account/ForgotPassword" class="body-small text-text-light">Quên mật khẩu?</a>
                    </div>
                </div>

                <div class="d-grid mt-3">
                    <button type="submit" class="btn btn-primary btn-modern">Đăng nhập</button>
                </div>

                <div class="text-center caption my-3">Hoặc đăng nhập bằng</div>

                <div class="d-flex gap-2 justify-content-center social-login">
                    <button type="button" class="btn btn-outline-secondary"><i class="bi bi-envelope-fill"></i> Email</button>
                    <button type="button" class="btn btn-outline-secondary"><i class="bi bi-google"></i> Google</button>
                </div>

                <p class="caption text-center text-text-light mt-3 mb-0">
                    Chưa có tài khoản? <a asp-page="/Account/Register">Đăng ký</a>
                </p>
            </form>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {
            // toggle password visibility
            const btn = document.getElementById('togglePwd');
            const pwd = document.getElementById('password');
            if (btn && pwd) {
                btn.addEventListener('click', function () {
                    if (pwd.type === 'password') { pwd.type = 'text'; btn.innerHTML = '<i class="bi bi-eye-slash"></i>'; }
                    else { pwd.type = 'password'; btn.innerHTML = '<i class="bi bi-eye"></i>'; }
                });
            }

            // show validation summary if has content
            const vs = document.getElementById('validationSummary');
            if (vs && vs.textContent.trim().length) {
                vs.classList.remove('visually-hidden');
            }
        })();
    </script>
</body>
</html>
