@page "/student/assignments"
@model LmsMini.WebApp.Pages.Student.AssignmentsModel
@{
    ViewData["Title"] = "Tất cả Bài tập";
}

<div class="container-fluid pt-4 fade-up">
    <h1 class="fw-bold mb-4">Tổng quan Bài tập</h1>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-warning">@Model.Message</div>
    }

    <div class="table-responsive">
        <table class="table table-bordered table-striped mt-4 custom-table">
            <thead>
                <tr>
                    <th><i class="fas fa-tag me-1"></i> Tên Bài tập</th>
                    <th><i class="fas fa-chalkboard me-1"></i> Lớp học</th>
                    <th><i class="fas fa-calendar-times me-1"></i> Hạn chót</th>
                    <th><i class="fas fa-check me-1"></i> Trạng thái Nộp</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Assignments.Any())
                {
                    @foreach (var assignment in Model.Assignments.OrderBy(a => a.Deadline))
                    {
                        <tr>
                            <td class="body-bold">@assignment.Title</td>
                            <td>@assignment.ClassroomName</td>
                            <td>@assignment.Deadline.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @{
                                    string badgeIcon;
                                    string badgeClass = assignment.Status switch
                                    {
                                        "Đã nộp" => "bg-success",
                                        "Nộp muộn" => "bg-danger",
                                        _ => "bg-warning"
                                    };
                                    badgeIcon = assignment.Status == "Đã nộp" ? "fa-check-circle" : "fa-exclamation-triangle";
                                }
                                <span class="badge @badgeClass body-small p-2">
                                    <i class="fas @badgeIcon me-1"></i> @assignment.Status
                                </span>
                            </td>
                            <td>
                                <a asp-page="/Student/AssignmentDetails" asp-route-id="@assignment.AssignId" class="btn btn-sm btn-info btn-modern">
                                    <i class="fas fa-eye"></i> Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center p-4 text-text-light">
                            <i class="fas fa-info-circle me-2"></i> Không có bài tập nào cần hoàn thành.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>