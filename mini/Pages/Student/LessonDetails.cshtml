@page "/student/class/{classroomId}/lesson/{lessonId}"
@model LmsMini.WebApp.Pages.Student.LessonDetailsModel
@{
    ViewData["Title"] = Model.Lesson?.Title ?? "Chi tiết bài giảng";
}

<div class="container-fluid pt-4 fade-up">
    <div class="mb-3">
        <a asp-page="/Student/ClassDetails" asp-route-id="@RouteData.Values["classroomId"]" class="btn btn-secondary btn-sm btn-modern">
            <i class="fas fa-arrow-left me-2"></i> Quay lại lớp học
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-danger shadow-sm">@Model.Message</div>
    }

    @if (Model.Lesson != null && !string.IsNullOrEmpty(Model.Lesson.LessonId))
    {
        <div class="card shadow-medium border-0">
            <div class="card-header bg-white py-3 border-bottom">
                <h2 class="h4 mb-1 text-primary-default fw-bold">@Model.Lesson.Title</h2>
                <div class="text-muted small">
                    <i class="far fa-calendar-alt me-1"></i> Ngày đăng: @(Model.Lesson.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                </div>
            </div>

            <div class="card-body p-4">
                <div class="mb-4 content-area">
                    <h5 class="fw-bold text-text-medium mb-3">Nội dung</h5>
                    <div class="bg-light p-3 rounded" style="white-space: pre-wrap; min-height: 100px;">
                        @(string.IsNullOrEmpty(Model.Lesson.Content) ? "Không có nội dung văn bản." : Model.Lesson.Content)
                    </div>
                </div>

                @if (Model.Lesson.Files != null && Model.Lesson.Files.Any())
                {
                    <hr class="my-4 text-muted opacity-25">
                    <h5 class="fw-bold text-text-medium mb-3"><i class="fas fa-paperclip me-2"></i> Tài liệu đính kèm</h5>

                    <div class="list-group list-group-flush border rounded">
                        @foreach (var file in Model.Lesson.Files)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center bg-white px-3 py-2">
                                <div class="d-flex align-items-center overflow-hidden">
                                    <div class="bg-primary-light text-white rounded p-2 me-3 flex-shrink-0">
                                        <i class="fas fa-file-alt"></i>
                                    </div>
                                    <span class="fw-semibold text-dark text-truncate" title="@file.FileName">@file.FileName</span>
                                </div>

                                <a asp-page-handler="DownloadFile"
                                   asp-route-classroomId="@RouteData.Values["classroomId"]"
                                   asp-route-fileId="@file.FilesId"
                                   class="btn btn-sm btn-outline-primary rounded-pill px-3 ms-3 flex-shrink-0">
                                    <i class="fas fa-download me-1"></i> Tải về
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>