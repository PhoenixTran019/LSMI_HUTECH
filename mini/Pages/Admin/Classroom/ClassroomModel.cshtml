@page
@model ClassroomModel
@{
    ViewData["Title"] = "Quản lý Lớp học";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center">
        <h2><i class="bi bi-person-workspace"></i> Quản lý Lớp học (Classroom)</h2>
        <button class="btn btn-success"
                data-bs-toggle="modal"
                data-bs-target="#createClassroomModal">
            <i class="bi bi-plus-circle"></i> Tạo lớp
        </button>
    </div>
    <hr />

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-@(Model.MessageType == "success" ? "success" : "danger") alert-dismissible fade show">
            @Model.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- FILTER -->
    <div class="card mb-4 p-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Tìm kiếm</label>
                <input asp-for="Filter.Keyword" class="form-control" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Khoa</label>
                <select asp-for="Filter.DepartmentId"
                        asp-items="Model.DepartmentOptions"
                        class="form-select">
                    <option value="">-- Tất cả --</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Lớp chính</label>
                <select asp-for="Filter.MainClassId"
                        asp-items="Model.ClassOptions"
                        class="form-select">
                    <option value="">-- Tất cả --</option>
                </select>
            </div>

            <div class="col-md-2">
                <button class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> Lọc
                </button>
            </div>
        </form>
    </div>

    <!-- TABLE -->
    <div class="card p-3">
        <h5>Danh sách lớp (@Model.Classrooms.Count)</h5>

        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tên</th>
                    <th>Môn</th>
                    <th>Lớp chính</th>
                    <th>GV</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Classrooms.Any())
                {
                    foreach (var c in Model.Classrooms)
                    {
                        <tr>
                            <td>@c.ClassroomId</td>
                            <td>@c.ClassName</td>
                            <td>@c.ClassSub</td>
                            <td>@c.MainClassName</td>   
                            <td>@c.LecturerName</td>
                            <td>
                                <a asp-page="/Admin/ClassroomDetail"
                                   asp-route-id="@c.ClassroomId"
                                   class="btn btn-sm btn-outline-info">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            Không có dữ liệu
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- CREATE MODAL -->
<div class="modal fade" id="createClassroomModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h5 class="modal-title">Tạo Classroom</h5>
                    <button class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body row g-3">

                    <div class="col-md-6">
                        <label class="form-label">Tên lớp</label>
                        <input asp-for="CreateForm.ClassName" class="form-control" />
                        <span asp-validation-for="CreateForm.ClassName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Môn học</label>

                        <input asp-for="CreateForm.ClassSub"
                               class="form-control"
                               list="subjectNameList"
                               placeholder="VD: IT Project Management" />

                        <datalist id="subjectNameList">
                            @foreach (var s in Model.SubjectOptions.Where(x => !string.IsNullOrWhiteSpace(x.Value)))
                            {
                                <option value="@s.Value"></option>
                            }
                        </datalist>

                        <span asp-validation-for="CreateForm.ClassSub" class="text-danger"></span>
                    </div>



                    <div class="col-md-6">
                        <label class="form-label">Lớp chính</label>
                        <select asp-for="CreateForm.MainClass"
                                asp-items="Model.CreateClassOptions"
                                class="form-select">
                            <option value="">-- Chọn lớp --</option>
                        </select>
                        <span asp-validation-for="CreateForm.MainClass" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Trạng thái</label>
                        <select asp-for="CreateForm.ClassStatus" class="form-select">
                            <option value="InTime">InTime</option>
                            <option value="AllowEnd">AllowEnd</option>
                            <option value="NonAllowEnd">NonAllowEnd</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Invite Code</label>
                        <input asp-for="CreateForm.InviteCode" class="form-control" />
                        <span asp-validation-for="CreateForm.InviteCode" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Mô tả</label>
                        <textarea asp-for="CreateForm.Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="CreateForm.Description" class="text-danger"></span>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Tạo</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (TempData["ShowCreateClassroomModal"]?.ToString() == "true")
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var el = document.getElementById('createClassroomModal');
                if (el) new bootstrap.Modal(el).show();
            });
        </script>
    }
}

